# rpm-mcp environment overrides
#
# Copy to `.env` and edit. OS environment variables take precedence over
# values set here. The full list of tunables and their defaults lives in
# `src/config.py` and is documented in `docs/architecture.md`.
#
# Only the variables most operators actually touch are listed here.

# --- Storage ----------------------------------------------------------------
# Postgres DSN. The default points at the local infra/infra.sh container.
DATABASE_URL=postgresql://rpm_mcp:rpm_mcp@127.0.0.1:5432/rpm_mcp

# --- Upstream forge tokens (optional; anonymous APIs are rate-limited) ------
# Lifts the GitHub Releases limit from 60 req/h to 5000 req/h.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# --- Logging ----------------------------------------------------------------
# `json` for structured production logs, `text` for human-readable dev output.
# LOG_FORMAT=text

# --- Source dispatch --------------------------------------------------------
# `waterfall` (default) or `parallel`. Parallel races all network sources
# and picks the one with the most entries; useful when OBS mirrors lag.
# FETCH_STRATEGY=waterfall
