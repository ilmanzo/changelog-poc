# rpm-mcp environment variables
# Copy to .env and adjust. OS environment variables always take precedence.
# Full source of truth: src/config.py

# ---------------------------------------------------------------------------
# PostgreSQL (change this for non-local setups)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://rpm_mcp:rpm_mcp@127.0.0.1:5432/rpm_mcp
# PG_POOL_MIN_SIZE=2
# PG_POOL_MAX_SIZE=20

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------
# CACHE_TTL_NEWS_S=86400        # news feeds: 24h
# CACHE_TTL_CHANGELOG_S=86400   # package changelogs: 24h
# CACHE_TTL_SPEC_S=604800       # spec files: 7d
# CACHE_MAX_ENTRIES=1000        # max changelog entries fetched per package
# CACHE_MAX_ENTRY_BYTES=8192    # per-entry truncation cap
# EVICTION_MIN_INTERVAL_S=3600  # min gap between opportunistic manifest sweeps

# ---------------------------------------------------------------------------
# Embedding model (fastembed)
# ---------------------------------------------------------------------------
# EMBEDDING_MODEL=              # empty = BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# EMBEDDING_BATCH_SIZE=100
# EMBEDDING_CHUNK_SIZE=1000     # spec-section chunk size in chars
# EMBEDDING_CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# LOG_FORMAT=text               # "json" for structured production logs

# ---------------------------------------------------------------------------
# Source registry
# ---------------------------------------------------------------------------
# FETCH_STRATEGY=waterfall      # "waterfall" | "parallel"

# ---------------------------------------------------------------------------
# Git repo cache
# ---------------------------------------------------------------------------
# GIT_CACHE_MAX_ENTRIES=50

# ---------------------------------------------------------------------------
# HTTP timeouts (OBS and other sources)
# ---------------------------------------------------------------------------
# OBS_TIMEOUT_TOTAL=30
# OBS_TIMEOUT_CONNECT=10
# OBS_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Subprocess (rpm, git)
# ---------------------------------------------------------------------------
# SUBPROCESS_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# Worker (centralised ingestion daemon)
# ---------------------------------------------------------------------------
# WORKER_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Upstream forge tokens (optional -- anonymous access without, but rate-limited)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Tool execution timeouts
# ---------------------------------------------------------------------------
# TOOL_TIMEOUT_FAST_S=10        # find_*, list_*, get_*, compare_*
# TOOL_TIMEOUT_SEARCH_S=30      # semantic_search, fts_search, live-API tools

# ---------------------------------------------------------------------------
# TestCatalog API (SUSE internal -- read endpoints are public)
# ---------------------------------------------------------------------------
# TESTCATALOG_URL=http://testcatalog.qa.suse.de:3001
# TESTCATALOG_API_KEY=          # optional Bearer JWT for write ops

# ---------------------------------------------------------------------------
# Composite-tool caps
# ---------------------------------------------------------------------------
# F4_MAX_PACKAGES=50            # BFS cap for get_dependency_changes
